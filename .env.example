# ============================================================
# Afnan Hany — AI Personal Brand Platform
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---------- Postgres ----------
POSTGRES_USER=afnan
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=brandplatform
DATABASE_URL=postgresql+psycopg://afnan:change-me-strong-password@db:5432/brandplatform

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=afnanhany18@gmail.com
ADMIN_PASSWORD=change-me-on-first-run

# ---------- LLM provider (any OpenAI-compatible API) ----------
# Option A — OpenAI (leave OPENAI_BASE_URL empty):
#   CHAT_MODEL=gpt-4o-mini  EMBEDDING_MODEL=text-embedding-3-small  EMBEDDING_DIM=1536  RAG_CONFIDENCE_THRESHOLD=0.32
# Option B — DeepInfra (cheap Llama hosting):
#   OPENAI_BASE_URL=https://api.deepinfra.com/v1/openai
#   CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#   EMBEDDING_MODEL=BAAI/bge-m3  EMBEDDING_DIM=1024  RAG_CONFIDENCE_THRESHOLD=0.45
# NOTE: EMBEDDING_DIM is baked into the vector column — pick the provider BEFORE
# first boot, or wipe the knowledge_* tables when switching.
OPENAI_API_KEY=
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# RAG: minimum cosine similarity before the assistant admits it doesn't know
RAG_CONFIDENCE_THRESHOLD=0.32
RAG_TOP_K=6

# ---------- Email (Resend) ----------
RESEND_API_KEY=
NOTIFY_EMAIL=afnanhany18@gmail.com
FROM_EMAIL=ai@afnanhany.dev

# ---------- OAuth (optional — leave blank to disable provider) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,https://afnanhany.dev
